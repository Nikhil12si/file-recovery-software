{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://frs.local/contracts/candidates.schema.json",
  "title": "candidates.json — Track A (C++ engine) -> Track B (Python analysis)",
  "description": "Written atomically by `win_recovery_engine scan --out <file>`. One document per scan. Byte offsets are relative to `source_device`; LBAs are in units of `sector_size`.",
  "type": "object",
  "required": ["schema_version", "engine", "scan", "sources", "statistics", "candidates"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": "1.0" },
    "engine": {
      "type": "object",
      "required": ["name", "version", "platform"],
      "additionalProperties": false,
      "properties": {
        "name": { "const": "win_recovery_engine" },
        "version": { "type": "string" },
        "platform": { "enum": ["windows-x64", "posix-image-test", "mock"] }
      }
    },
    "scan": {
      "type": "object",
      "required": ["scan_id", "mode", "target_scope", "started_at", "finished_at", "status", "elevated", "source_specs", "type_filter", "options"],
      "additionalProperties": false,
      "properties": {
        "scan_id": { "type": "string" },
        "mode": { "enum": ["quick", "deep"] },
        "target_scope": { "enum": ["all", "drive", "folder"] },
        "folder_path": { "type": ["string", "null"] },
        "started_at": { "type": "string", "format": "date-time" },
        "finished_at": { "type": "string", "format": "date-time" },
        "status": { "enum": ["completed", "partial", "cancelled", "failed"] },
        "elevated": { "type": "boolean" },
        "source_specs": { "type": "array", "items": { "type": "string" } },
        "type_filter": { "type": "array", "items": { "type": "string" } },
        "options": {
          "type": "object",
          "required": ["sector_aligned", "unallocated_only", "verify_headers", "sample_dir", "sample_bytes", "max_candidates"],
          "additionalProperties": false,
          "properties": {
            "sector_aligned": { "type": "boolean" },
            "unallocated_only": { "type": "boolean" },
            "verify_headers": { "type": "boolean" },
            "sample_dir": { "type": ["string", "null"] },
            "sample_bytes": { "type": "integer", "minimum": 0 },
            "max_candidates": { "type": "integer", "minimum": 0 }
          }
        }
      }
    },
    "sources": { "type": "array", "items": { "$ref": "#/$defs/source" } },
    "statistics": {
      "type": "object",
      "required": ["total_candidates", "total_bytes", "read_errors", "samples_bytes_written", "by_method", "by_extension"],
      "additionalProperties": false,
      "properties": {
        "total_candidates": { "type": "integer", "minimum": 0 },
        "total_bytes": { "type": "integer", "minimum": 0 },
        "read_errors": { "type": "integer", "minimum": 0 },
        "samples_bytes_written": { "type": "integer", "minimum": 0 },
        "by_method": { "type": "object", "additionalProperties": { "type": "integer" } },
        "by_extension": { "type": "object", "additionalProperties": { "type": "integer" } }
      }
    },
    "candidates": { "type": "array", "items": { "$ref": "#/$defs/candidate" } }
  },
  "$defs": {
    "source": {
      "type": "object",
      "required": ["source_id", "device_path", "kind", "display_name", "filesystem", "media_type", "sector_size", "cluster_size",
                   "total_bytes", "bytes_scanned", "partition_offset_bytes", "volume_offset_in_device", "physical_drive_index",
                   "mft_records_scanned", "deleted_entries_found", "candidates", "read_errors", "status", "error", "elapsed_seconds"],
      "additionalProperties": false,
      "properties": {
        "source_id": { "type": "string", "description": "Stable short id: vol-D, pd1, pd1-p2, img-<file>" },
        "device_path": { "type": "string", "examples": ["\\\\.\\D:", "\\\\.\\PhysicalDrive1", "C:\\images\\disk.dd"] },
        "kind": { "enum": ["volume", "physical", "image"] },
        "display_name": { "type": "string" },
        "letter": { "type": ["string", "null"] },
        "volume_guid_path": { "type": ["string", "null"] },
        "filesystem": { "type": "string" },
        "media_type": { "enum": ["HDD", "SSD", "Unknown", "Image"] },
        "sector_size": { "type": "integer" },
        "cluster_size": { "type": "integer" },
        "total_bytes": { "type": "integer" },
        "bytes_scanned": { "type": "integer" },
        "partition_offset_bytes": { "type": "integer" },
        "volume_offset_in_device": { "type": "integer" },
        "physical_drive_index": { "type": "integer" },
        "mft_records_scanned": { "type": "integer" },
        "deleted_entries_found": { "type": "integer" },
        "candidates": { "type": "integer" },
        "read_errors": { "type": "integer", "description": "Unreadable sectors that were zero-filled (drive health signal)" },
        "status": { "enum": ["pending", "completed", "cancelled", "failed", "unsupported"] },
        "error": { "type": ["string", "null"] },
        "elapsed_seconds": { "type": "number" }
      }
    },
    "extent": {
      "type": "object",
      "required": ["offset", "length", "sparse"],
      "additionalProperties": false,
      "properties": {
        "offset": { "type": "integer", "minimum": 0, "description": "Byte offset inside source_device (0 when sparse)" },
        "length": { "type": "integer", "minimum": 0 },
        "sparse": { "type": "boolean", "description": "Zero-filled run with no on-disk storage" }
      }
    },
    "candidate": {
      "type": "object",
      "required": ["id", "source_id", "source_device", "source_kind", "method", "file_name", "original_path", "extension", "signature",
                   "mime_type", "size_bytes", "lba", "absolute_lba", "sector_size", "extents", "fragment_count", "resident_data_b64",
                   "timestamps", "mft", "integrity", "partition_hint", "notes", "sample_path", "sample_bytes"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "description": "Unique within the scan: <source_id>-mft-<record> | -fat-<entry hex> | -carve-<offset hex>" },
        "source_id": { "type": "string" },
        "source_device": { "type": "string", "description": "Exact path to open for recovery" },
        "source_kind": { "enum": ["volume", "physical", "image"] },
        "method": { "enum": ["mft", "fat", "carve"] },
        "file_name": { "type": ["string", "null"], "description": "Original name (null for carved files)" },
        "original_path": { "type": ["string", "null"], "description": "Reconstructed full path, e.g. D:\\Users\\me\\a.pdf; '$Orphan' marks an unresolvable parent" },
        "extension": { "type": "string" },
        "signature": { "type": ["string", "null"], "description": "Signature id detected in the content (see `signatures` command)" },
        "mime_type": { "type": "string" },
        "size_bytes": { "type": "integer", "minimum": 0 },
        "lba": { "type": "integer", "minimum": 0 },
        "absolute_lba": { "type": "integer", "minimum": 0, "description": "LBA relative to the physical disk (used for proximity clustering)" },
        "sector_size": { "type": "integer" },
        "extents": { "type": "array", "items": { "$ref": "#/$defs/extent" } },
        "fragment_count": { "type": "integer", "minimum": 0 },
        "resident_data_b64": { "type": ["string", "null"], "description": "NTFS resident $DATA payload (small files stored inside the MFT record)" },
        "timestamps": {
          "type": "object",
          "required": ["created", "modified", "mft_modified", "accessed"],
          "additionalProperties": false,
          "properties": {
            "created": { "type": ["string", "null"] },
            "modified": { "type": ["string", "null"] },
            "mft_modified": { "type": ["string", "null"], "description": "NTFS: approximates the deletion time" },
            "accessed": { "type": ["string", "null"] }
          }
        },
        "mft": {
          "type": ["object", "null"],
          "required": ["record_number", "sequence", "parent_record", "record_flags", "file_attributes", "is_compressed", "is_encrypted", "is_sparse", "fixup_error"],
          "additionalProperties": false,
          "properties": {
            "record_number": { "type": "integer" },
            "sequence": { "type": "integer" },
            "parent_record": { "type": "integer" },
            "record_flags": { "type": "integer", "description": "0x01 in-use (always clear here), 0x02 directory" },
            "file_attributes": { "type": "integer" },
            "is_compressed": { "type": "boolean" },
            "is_encrypted": { "type": "boolean" },
            "is_sparse": { "type": "boolean" },
            "fixup_error": { "type": "boolean" }
          }
        },
        "integrity": {
          "type": "object",
          "required": ["header_check", "footer_found", "size_estimated", "size_source", "truncated", "allocated_ratio", "path_orphaned"],
          "additionalProperties": false,
          "properties": {
            "header_check": { "enum": ["match", "mismatch", "unknown"] },
            "footer_found": { "type": ["boolean", "null"], "description": "Carving: end-of-file structure confirmed. null for metadata-based recovery" },
            "size_estimated": { "type": "boolean" },
            "size_source": { "enum": ["metadata", "footer", "length_field", "structure", "estimated"] },
            "truncated": { "type": "boolean" },
            "allocated_ratio": { "type": ["number", "null"], "minimum": 0, "maximum": 1,
              "description": "mft/fat: share of the file's clusters now owned by other files (overwrite risk). carve: share inside allocated space" },
            "path_orphaned": { "type": "boolean" }
          }
        },
        "partition_hint": { "type": ["string", "null"] },
        "notes": { "type": "array", "items": { "type": "string" } },
        "sample_path": { "type": ["string", "null"], "description": "Preview sample (first sample_bytes of content) written to --sample-dir" },
        "sample_bytes": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
