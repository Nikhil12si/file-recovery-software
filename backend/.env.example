# Copy to .env (in this backend folder) and adjust. Every value is optional for local development:
# lines that stay commented out use safe defaults. Relative paths are relative to this backend folder.

# PostgreSQL (recommended). When unset, an SQLite file in DATA_DIR is used.
# scripts\setup-database.ps1 creates the database; use the same user/password you gave it:
# DATABASE_URL=postgresql://postgres:<password>@localhost:5432/file_recovery

# Path to the C++ engine. ENGINE_MODE=auto uses it when the file exists, otherwise the mock engine.
# When unset, engine\build\Release\ and engine\build\ are searched automatically.
# ENGINE_PATH=..\engine\build\Release\win_recovery_engine.exe
ENGINE_MODE=auto

# Working data (candidates.json, thumbnails, reports). Default: backend\data.
# Put it on a drive you are NOT recovering from, e.g.:
# DATA_DIR=E:\RecoveryWork\data
# Preview samples written by the engine during scans (must also be on a separate drive). Default: DATA_DIR\samples
# SAMPLE_DIR=E:\RecoveryWork\samples
SAMPLE_BYTES=2097152
SAMPLE_BUDGET_MB=2048

# Security
# JWT_SECRET: leave unset to use a random secret generated once and stored in DATA_DIR\.jwt_secret.
# If you set it, use a long random string (for example: python -c "import secrets; print(secrets.token_urlsafe(48))").
# JWT_SECRET=
JWT_TTL_MINUTES=480
ALLOW_REGISTRATION=true
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Performance
ANALYSIS_WORKERS=4
MAX_CONCURRENT_SCANS=1
MAX_CANDIDATES=500000

# Mock engine tuning (development only)
MOCK_SCAN_SECONDS=6
MOCK_ELEVATED=true
